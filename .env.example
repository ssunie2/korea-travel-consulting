# 이 파일은 "어떤 값이 필요한지"만 적어둔 예시다. 실제 값은 .env.local 에 넣는다 (.env.local은 git에 안 올라감).
#
# NEXT_PUBLIC_ 이 붙은 값은 브라우저까지 전달된다 = 손님도 볼 수 있다. 공개돼도 되는 값만 넣는다.
# 붙지 않은 값은 서버에만 남는다. 비밀 키는 반드시 여기에 넣는다.

# Supabase 대시보드 > Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=

# service_role 키 — DB를 전부 읽고 쓸 수 있는 마스터 키다. 절대 브라우저로 보내지 않는다
SUPABASE_SERVICE_ROLE_KEY=

# AI 키 — 절대 NEXT_PUBLIC_ 을 붙이지 않는다 (붙이면 손님이 우리 키를 훔쳐 쓸 수 있다)
GEMINI_API_KEY=

# 관리자 화면(/admin) 비밀번호. 아무 값이나 길게 정해서 둘이 공유한다
ADMIN_PASSWORD=

# 메일 보내는 서비스 (Resend). https://resend.com 에서 만든다
RESEND_API_KEY=

# 신청이 들어왔을 때 우리가 받을 주소
ADMIN_EMAIL=

# 보내는 사람 주소. 비우면 Resend 기본값(onboarding@resend.dev)을 쓴다.
# ⚠️ 기본값으로는 **Resend 계정 본인에게만** 보내진다. 도메인을 인증해야 손님에게 간다
RESEND_FROM=

# 메일 안의 링크가 가리킬 주소. 비우면 Vercel 이 주는 배포 주소를 쓴다
NEXT_PUBLIC_SITE_URL=
