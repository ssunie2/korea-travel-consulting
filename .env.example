# 이 파일은 "어떤 값이 필요한지"만 적어둔 예시다. 실제 값은 .env.local 에 넣는다 (.env.local은 git에 안 올라감).
#
# NEXT_PUBLIC_ 이 붙은 값은 브라우저까지 전달된다 = 손님도 볼 수 있다. 공개돼도 되는 값만 넣는다.
# 붙지 않은 값은 서버에만 남는다. 비밀 키는 반드시 여기에 넣는다.

# Supabase 대시보드 > Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=

# service_role 키 — DB를 전부 읽고 쓸 수 있는 마스터 키다. 절대 브라우저로 보내지 않는다
SUPABASE_SERVICE_ROLE_KEY=

# AI 키 — 절대 NEXT_PUBLIC_ 을 붙이지 않는다 (붙이면 손님이 우리 키를 훔쳐 쓸 수 있다)
GEMINI_API_KEY=
